[resource]
script = ExtResource("1_schedule")
id = &"first_shift"
display_name = "Bakkal After Dark — First Shift"
duration_seconds = 300.0
phases = Array[ExtResource("2_phase_type")]([ExtResource("3_opening"), ExtResource("4_carts"), ExtResource("5_freezer"), ExtResource("6_lights"), ExtResource("7_open_door")])
