[gd_resource type="Resource" script_class="ShiftScheduleDefinition" load_steps=9 format=3]

[ext_resource type="Script" path="res://data/shift_schedule_definition.gd" id="1_schedule"]
[ext_resource type="Script" path="res://data/shift_phase_definition.gd" id="2_phase_type"]
[ext_resource type="Resource" path="res://data/shifts/phase_opening.tres" id="3_opening"]
[ext_resource type="Resource" path="res://data/shifts/phase_carts.tres" id="4_carts"]
[ext_resource type="Resource" path="res://data/shifts/phase_freezer_aisle.tres" id="5_freezer"]
[ext_resource type="Resource" path="res://data/shifts/phase_lights_out.tres" id="6_lights"]
