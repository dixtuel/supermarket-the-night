# D-pad sends arrow keys to Godot's UI focus navigation. PortMaster gameplay
# movement reads the left-stick WASD actions separately.
up = up
up = repeat
down = down
down = repeat
left = left
left = repeat
right = right
right = repeat

# Left stick maps to the movement keys configured in project.godot.
left_analog_up = w
left_analog_down = s
left_analog_left = a
left_analog_right = d

# gptokeyb assigns one output per physical button: A/B are mouse clicks,
# while the D-pad remains available for keyboard focus navigation.
a = mouse_left
b = mouse_right
x = e
y = r
# Start pauses/resumes the game; Select cancels UI.
start = esc
back = esc

# Right stick moves the pointer; A/B provide left/right clicks.
right_analog_up = mouse_movement_up
right_analog_down = mouse_movement_down
right_analog_left = mouse_movement_left
right_analog_right = mouse_movement_right

deadzone_mode = scaled_radial
deadzone = 2000
deadzone_scale = 8
deadzone_delay = 16
