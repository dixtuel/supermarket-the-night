# PortMaster UI is keyboard-driven through gptokeyb2. Do not enable key repeat:
# a held D-pad direction moves focus once, then moves again only on a new press.
up = up
down = down
left = left
right = right

# Left stick maps to the movement keys configured in project.godot.
left_analog_up = w
left_analog_down = s
left_analog_left = a
left_analog_right = d

# Focus navigation lets A activate the selected Godot UI control reliably even
# when the Weston cursor is not over it. B returns/cancels. X is the game's E
# interaction key. Shoulder buttons provide pointer clicks when using the
# right-stick mouse.
a = enter
b = esc
x = e
y = r
start = esc
back = esc
l1 = mouse_left
r1 = mouse_right

# Right stick moves the pointer; L1/R1 provide left/right clicks.
right_analog_up = mouse_movement_up
right_analog_down = mouse_movement_down
right_analog_left = mouse_movement_left
right_analog_right = mouse_movement_right

deadzone_mode = scaled_radial
deadzone = 2000
deadzone_scale = 8
deadzone_delay = 16
