# D-pad sends arrow keys to Godot's UI focus navigation. PortMaster gameplay
# movement reads the left-stick WASD actions separately.
up = up
up = repeat
down = down
down = repeat
left = left
left = repeat
right = right
right = repeat

# Left stick maps to the movement keys configured in project.godot.
left_analog_up = w
left_analog_down = s
left_analog_left = a
left_analog_right = d

a = enter
b = esc
x = e
y = r
# Start pauses/resumes the game; A remains the confirm/select button.
start = esc
back = esc

deadzone_mode = scaled_radial
deadzone = 2000
deadzone_scale = 8
deadzone_delay = 16
